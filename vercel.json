{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    { "source": "/cv", "destination": "/cvwrapper", "permanent": true },
    { "source": "/Projects", "destination": "/projects", "permanent": true },
    { "source": "/Projects/:slug", "destination": "/projects/:slug", "permanent": true },
    { "source": "/Qualification", "destination": "/qualification", "permanent": true },
    { "source": "/Qualification/:slug", "destination": "/qualification/:slug", "permanent": true }
  ],
  "rewrites": [
    { "source": "/adminsignin", "destination": "/spa" },
    { "source": "/AdminSignIn", "destination": "/spa" },
    { "source": "/adminhome", "destination": "/spa" },
    { "source": "/AdminHome", "destination": "/spa" },
    { "source": "/adminhome/:path*", "destination": "/spa" },
    { "source": "/AdminHome/:path*", "destination": "/spa" }
  ]
}
